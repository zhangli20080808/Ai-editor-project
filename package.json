{
  "name": "lego-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "dev": "turbo run dev",
    "dev:admin": "pnpm --filter admin-server dev",
    "dev:admin-fe": "pnpm --filter admin-fe dev",
    "dev:apps": "turbo run dev --filter=biz-editor-fe --filter=biz-editor-server --filter=h5-server --filter=admin-server --filter=admin-fe",
    "dev:fe": "pnpm --filter biz-editor-fe dev",
    "dev:h5": "pnpm --filter h5-server dev",
    "dev:clean-ports": "node scripts/kill-dev-ports.mjs",
    "dev:local": "pnpm dev:clean-ports && pnpm mongo:up && pnpm dev:apps",
    "dev:server": "pnpm --filter biz-editor-server dev",
    "deploy:build": "docker compose --env-file .env.deploy -f docker-compose.prod.yml build",
    "deploy:down": "docker compose --env-file .env.deploy -f docker-compose.prod.yml down",
    "deploy:logs": "docker compose --env-file .env.deploy -f docker-compose.prod.yml logs -f",
    "deploy:up": "docker compose --env-file .env.deploy -f docker-compose.prod.yml up -d",
    "lint": "turbo run lint",
    "mongo:down": "docker stop ai-editor-mongo",
    "mongo:up": "docker start ai-editor-mongo >/dev/null 2>&1 || docker run -d --name ai-editor-mongo -p 27017:27017 -v ai-editor-mongo-data:/data/db mongo:7",
    "release": "pnpm --filter @zhangli2008/ai-editor-components build && changeset publish",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.5.0"
  }
}
