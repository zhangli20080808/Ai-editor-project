# Browser-visible addresses. Replace these with real domains in production.
FE_PUBLIC_BASE_URL=http://localhost:8080
API_PUBLIC_BASE_URL=http://localhost:7001
H5_PUBLIC_BASE_URL=http://localhost:7002
ADMIN_FE_PUBLIC_BASE_URL=http://localhost:8081
ADMIN_API_PUBLIC_BASE_URL=http://localhost:7003

# Server runtime configuration.
MONGODB_URI=mongodb://mongo:27017/ai_editor
AUTH_SECRET=replace-with-a-long-random-secret
MOCK_SMS_CODE=123456

# OpenAI-compatible model configuration. Do not expose LLM_API_KEY to the frontend.
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Docker exposed ports.
FE_PORT=8080
API_PORT=7001
H5_PORT=7002
ADMIN_PORT=7003
ADMIN_FE_PORT=8081
